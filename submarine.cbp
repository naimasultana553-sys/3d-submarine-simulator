<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="3D Submarine Simulator" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/submarine" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add library="opengl32" />
					<Add library="glu32" />
					<Add library="freeglut" />
					<Add library="gdi32" />
					<Add library="winmm" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/submarine" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add library="opengl32" />
					<Add library="glu32" />
					<Add library="freeglut" />
					<Add library="gdi32" />
					<Add library="winmm" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Linker>
			<Add option="-mconsole" />
		</Linker>
		<Unit filename="submarine.cpp">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions>
			<code_completion />
			<debugger />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
